# Copy to `.env` and run with:
#   flutter run --dart-define-from-file=.env
#
# If you omit `.env` / the flag, the app uses production URLs.

# Staging
BASE_URL=https://spring-staging.fairytrail.app
WEB_API_BASE_URL=https://web-api-staging.fairytrail.app

# Local API (optional)
# BASE_URL=http://localhost:8000
# WEB_API_BASE_URL=http://localhost:8000

# Production (defaults when unset)
# BASE_URL=https://spring.fairytrail.app
# WEB_API_BASE_URL=https://web-api.fairytrail.app
